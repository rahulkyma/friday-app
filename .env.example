# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Meta/Instagram Configuration
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id_here
INSTAGRAM_PAGE_ID=your_facebook_page_id_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Content Configuration
CONTENT_NICHE=technology
CONTENT_LANGUAGE=hi
CONTENT_TONE=professional

# Scheduling
SCHEDULE_TIME=09:00
TIMEZONE=Asia/Kolkata

# Features Toggle
ENABLE_POSTING=true
ENABLE_COMMENTS=true
ENABLE_ANALYTICS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/instagram_automation.log

# Safety & Limits
MAX_COMMENTS_PER_RUN=50
MIN_COMMENT_LENGTH=10
SPAM_KEYWORDS=spam,buy,click,link,follow
